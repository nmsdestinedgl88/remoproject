 ],
 "sentences": [
  {
   "i": 1,
   "t0": 0.3,
   "text": "Dangote Cement has a problem."
  },
  {
   "i": 2,
   "t0": 2.87,
   "text": "Not enough Africans can afford to build."
  },
  {
   "i": 3,
   "t0": 5.78,
   "text": "The continent consumes only 140 kilograms of cement per person per year."
  },
  {
   "i": 4,
   "t0": 11.78,
   "text": "Developed markets consume five times that."
  },
  {
   "i": 5,
   "t0": 14.96,
   "text": "The demand is not missing."
  },
  {
   "i": 6,
   "t0": 16.54,
   "text": "It is locked behind financing."
  },
  {
   "i": 7,
   "t0": 18.88,
   "text": "High interest rates."
  },
  {
   "i": 8,
   "t0": 20.13,
   "text": "Impossible collateral."
  },
  {
   "i": 9,
   "t0": 21.94,
   "text": "Millions want to build."
  },
  {
   "i": 10,
   "t0": 23.42,
   "text": "Millions cannot borrow."
  },
  {
   "i": 11,
   "t0": 24.96,
   "text": "So the capacity sits idle."
  },
  {
   "i": 12,
   "t0": 27.21,
   "text": "What if Dangote stopped waiting for customers and started creating them."
  },
  {
   "i": 13,
   "t0": 31.44,
   "text": "Dangote Home Finance acquires mortgage banks across the continent."
  },
  {
   "i": 14,
   "t0": 35.74,
   "text": "Abbey Bank in Nigeria."
  },
  {
   "i": 15,
   "t0": 37.48,
   "text": "SA Home Loans in South Africa."
  },
  {
   "i": 16,
   "t0": 39.67,
   "text": "First Housing Finance in Tanzania."
  },
  {
   "i": 17,
   "t0": 42.07,
   "text": "Zambian Home Loans."
  },
  {
   "i": 18,
   "t0": 43.52,
   "text": "BCH in Congo."
  },
  {
   "i": 19,
   "t0": 45.18,
   "text": "GGB Bank in Ghana."
  },
  {
   "i": 20,
   "t0": 47.07,
   "text": "These are customer acquisition machines."
  },
  {
   "i": 21,
   "t0": 49.76,
   "text": "Dangote Home Finance guarantees loans issued through these banks."
  },
  {
   "i": 22,
   "t0": 53.66,
   "text": "It holds 24 months of repayment obligations as collateral."
  },
  {
   "i": 23,
   "t0": 57.68,
   "text": "This guarantee convinces Euro-area banks to lend at 3.54 percent instead of 25 percent."
  },
  {
   "i": 24,
   "t0": 64.9,
   "text": "The European lender takes zero risk for the first two years."
  },
  {
   "i": 25,
   "t0": 68.67,
   "text": "In exchange, the borrower gets a home."
  },
  {
   "i": 26,
   "t0": 71.29,
   "text": "And Dangote gets a customer who must use Dangote cement."
  },
  {
   "i": 27,
   "t0": 75.57,
   "text": "When a borrower defaults, DHF pays the lender."
  },
  {
   "i": 28,
   "t0": 79.04,
   "text": "The property is auctioned to a new buyer."
  },
  {
   "i": 29,
   "t0": 81.36,
   "text": "That buyer continues the payment."
  },
  {
   "i": 30,
   "t0": 83.4,
   "text": "The cement was already sold."
  },
  {
   "i": 31,
   "t0": 85.18,
   "text": "The capital is recycled."
  },
  {
   "i": 32,
   "t0": 87.01,
   "text": "The cycle continues."
  },
  {
   "i": 33,
   "t0": 89.07,
   "text": "Because DHF operates through the banks it owns, funds are disbursed directly to approved contractors."
  },
  {
   "i": 34,
   "t0": 95.22,
   "text": "The borrower never touches the money."
  },
  {
   "i": 35,
   "t0": 97.26,
   "text": "The cement flows."
  },
  {
   "i": 36,
   "t0": 98.75,
   "text": "Sales are locked in before the foundation is poured."
  },
  {
   "i": 37,
   "t0": 101.83,
   "text": "One million homes means one million cement orders."
  },
  {
   "i": 38,
   "t0": 105.31,
   "text": "This is not development aid."
  },
  {
   "i": 39,
   "t0": 107.34,
   "text": "This is a demand generation engine disguised as a mortgage company."
  },
  {
   "i": 40,
   "t0": 111.99,
   "text": "Dangote Home Finance."
  },
  {
   "i": 41,
   "t0": 113.57,
   "text": "We are not selling loans."
  },
  {
   "i": 42,
   "t0": 115.07,
   "text": "We are selling cement."
  }
 ]
}