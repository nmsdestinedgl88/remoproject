{
  "name": "remoproject",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "studio": "remotion studio",
    "build": "remotion render HelloWorld out/HelloWorld.mp4",
    "still": "remotion still HelloWorld out/frame0.png --frame=0",
    "sfx:eliakim": "node scripts/gen-sfx-eliakim.mjs",
    "render:eliakim": "remotion render src/index.ts EliakimVideo out/eliakim.mp4 --codec h264 --crf 17"
  },
  "dependencies": {
    "@remotion/cli": "4.0.250",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.250"
  },
  "devDependencies": {
    "@fontsource/anton": "^5.3.0",
    "@fontsource/archivo": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "@types/react": "18.3.3",
    "hyperframes": "^0.9.17",
    "typescript": "5.5.4"
  }
}